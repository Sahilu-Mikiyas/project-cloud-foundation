# Browser-safe Supabase configuration. Publishable keys are protected by RLS.
VITE_SUPABASE_URL=https://xczypfauwzeaogijcwgj.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side Supabase configuration. Keep service-role keys out of browser builds.
SUPABASE_URL=https://xczypfauwzeaogijcwgj.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Supabase database connection for Drizzle migrations. Keep the password secret.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xczypfauwzeaogijcwgj.supabase.co:5432/postgres
