# Browser-safe Supabase configuration. Publishable keys are protected by RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side Supabase configuration. Keep service-role keys out of browser builds.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Trusted local migration connection; do not use a production database for local work.
LOVABLE_DB_MIGRATION_URL=postgresql://user:password@localhost:5432/shanta
